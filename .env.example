# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (required)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (required - use either SUPABASE_SERVICE_KEY or SUPABASE_SERVICE_ROLE_KEY)
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Alternative: SUPABASE_SERVICE_ROLE_KEY (both work, use whichever you prefer)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase table name for candidate sync (default: auto_apply_cand)
SUPABASE_TABLE=auto_apply_cand

# ============================================
# SQL Server Configuration (Apply API - Connection Pool Method)
# ============================================
# Use these if you want to use individual connection parameters for Apply API
# SQL_SERVER_HOST=your-sql-server-host
# SQL_SERVER_DATABASE=HealthWorks
# SQL_SERVER_USER=your_username
# SQL_SERVER_PASSWORD=your_password
# SQL_SERVER_PORT=1433
# SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server

# ============================================
# SQL Server Configuration (Candidate Sync API - Connection String Method)
# ============================================
# Alternative: Use a full connection string (recommended for Candidate Sync API)
# Replace with your actual connection string
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=your-server-ip-or-hostname;Database=HealthWorks;UID=your_username;PWD=your_password;Encrypt=yes;TrustServerCertificate=yes;

# SQL Server connection timeout in seconds (default: 5)
SQLSERVER_CONNECT_TIMEOUT=5

# SQL Server query timeout in seconds (default: 10)
SQLSERVER_QUERY_TIMEOUT=10

# ============================================
# Connection Pool Configuration (for Apply API)
# ============================================
# Minimum number of connections in pool (default: 5)
SQL_SERVER_POOL_MIN=5

# Maximum number of connections in pool (default: 20)
SQL_SERVER_POOL_MAX=20

# ============================================
# Retry Configuration
# ============================================
# Maximum number of retry attempts for failed operations (default: 3)
RETRY_MAX_ATTEMPTS=3

# Initial delay before first retry in seconds (default: 1.0)
RETRY_INITIAL_DELAY=1.0

# Maximum delay between retries in seconds (default: 60.0)
RETRY_MAX_DELAY=60.0

# Exponential backoff base multiplier (default: 2.0)
# Delay = initial_delay * (base ^ attempt_number)
RETRY_EXPONENTIAL_BASE=2.0

# ============================================
# Application Configuration
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Emit logs in JSON format (default: false)
# Set to true for structured logging (useful for log aggregation tools)
LOG_JSON=false

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated list of allowed origins for CORS
# Leave commented out to disable CORS, or uncomment and add your origins
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Required - Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Required for Resume Intake API
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=RW_Resumes
VECTOR_SIZE=1536

#Get RequirementDetails API configuration 
REQUIREMENT_DETAILS_DB_SERVER=your_server
REQUIREMENT_DETAILS_DB_NAME=your_database
REQUIREMENT_DETAILS_DB_USER=your_username
REQUIREMENT_DETAILS_DB_PASSWORD=your_password
REQUIREMENT_DETAILS_DB_DRIVER={ODBC Driver 17 for SQL Server}
REQUIREMENT_DETAILS_DB_POOL_SIZE=20
REQUIREMENT_DETAILS_RATE_LIMIT=100/minute

